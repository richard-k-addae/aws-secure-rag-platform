AWS_REGION=us-east-1
# Model ID is configuration, not code - demonstrates model portability
BEDROCK_MODEL_ID=anthropic.claude-sonnet-example-model-id
APP_ENV=dev
LOG_LEVEL=INFO
# dev mode only: full content logging with synthetic data (never in prod)
LOG_FULL_CONTENT=false
# Embeddings
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# Vector store (local dev; production uses Secrets Manager)
# Runtime role: must be NOSUPERUSER NOBYPASSRLS or row-level security is inert
DATABASE_URL=postgresql://rag_app:rag_app@localhost:5432/rag
# Administrative role: DDL, policy and role provisioning only
ADMIN_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
APP_DB_ROLE=rag_app
APP_DB_PASSWORD=rag_app
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
# Tenancy: a verified identity's tenant group must also be listed here
TENANT_ALLOWLIST=tenant-a,tenant-b
# Verified identity (Cognito user pool access tokens). Placeholders only.
# Left empty, protected routes fail closed with 503 "Authentication unavailable".
# Issuer format: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
OIDC_ISSUER=
# Comma-separated app client IDs whose access tokens are accepted
OIDC_CLIENT_IDS=
# Only for access tokens requested with a resource binding (they carry aud)
OIDC_AUDIENCE=
OIDC_LEEWAY_SECONDS=30
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_JWKS_REFRESH_COOLDOWN_SECONDS=30
